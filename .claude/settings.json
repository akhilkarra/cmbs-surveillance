{
  "enabledPlugins": {
    "mattpocock-skills@claude-plugins-official": true,
    "typesafe@typesafe-ai": true
  },
  "permissions": {
    "deny": [
      "Edit(/features/APPROVED.sha256)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard_approved_features.py"
          }
        ]
      }
    ]
  }
}
